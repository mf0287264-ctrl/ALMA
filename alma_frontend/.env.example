NEXT_PUBLIC_BASE_API=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# NextAuth — required for next-auth to work
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_characters_here

# Token encryption key (used to encrypt the backend JWT before storing in the cookie)
# Must be exactly 32 characters for AES-256
TOKEN_ENCRYPTION_KEY=your_32_char_encryption_key_here!!
