PORT=5000
MONGODB_URI=mongodb://localhost:27017
DB_NAME=ALMA
NODE_ENV=development

# JWT / Token Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ISSUER=alma-api
JWT_AUDIENCE=alma-web
JWT_REFRESH_EXPIRES_IN=30d

# Optional legacy student-code cache; authentication uses persistent MongoDB sessions
REDIS_URL=redis://127.0.0.1:6379

# Lesson generation: keep the model credential on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 only when an external worker consumes lesson_generations jobs.
LESSON_GENERATION_EXTERNAL_WORKER=

# Bind behind a TLS reverse proxy. Set TRUST_PROXY=loopback only for a local trusted proxy.
HOST=127.0.0.1
TRUST_PROXY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# One-time first administrator provisioning (unset after bootstrap).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
