              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"COURSE_ID_HERE\",\n  \"module_id\": \"MODULE_ID_HERE\",\n  \"topic\": \"Python For Loops & Range Function\",\n  \"programming_language\": \"Python\",\n  \"grade_level\": \"Grade 8\",\n  \"target_duration_minutes\": 15,\n  \"current_version_no\": 1,\n  \"approved_version_no\": null,\n  \"created_by\": \"TEACHER_ID_HERE\",\n  \"versions\": [\n    {\n      \"version_no\": 1,\n      \"state\": \"AWAITING_REVIEW\",\n      \"title\": \"Mastering Python For Loops & Range Function\",\n      \"introduction\": [\n        {\n          \"type\": \"paragraph\",\n          \"text\": \"Welcome to Python loops! In programming, repeating tasks manually is slow. Loops let us automate repetition effortlessly.\"\n        },\n        {\n          \"type\": \"callout\",\n          \"callout_type\": \"tip\",\n          \"text\": \"Pro Tip: Loops are the secret weapon to processing large collections of data in milliseconds.\"\n        }\n      ],\n      \"sections\": [\n        {\n          \"order\": 1,\n          \"title\": \"Understanding the range() Function\",\n          \"purpose\": \"Explain zero-based indexing and default start values.\",\n          \"covers_objectives\": [\n            \"Explain range(n) behavior\",\n            \"Identify zero-based start index\"\n          ],\n          \"blocks\": [\n            {\n              \"type\": \"paragraph\",\n              \"text\": \"In Python, range(5) generates integers starting at 0 up to, but not including, 5.\"\n            },\n            {\n              \"type\": \"code\",\n              \"language\": \"python\",\n              \"code\": \"for i in range(5):\\n    print(i)\",\n              \"expected_output\": \"0\\n1\\n2\\n3\\n4\"\n            },\n            {\n              \"type\": \"list\",\n              \"items\": [\n                \"Default start value is 0\",\n                \"Stop value is exclusive\",\n                \"Default step size is 1\"\n              ]\n            }\n          ],\n          \"diagnostic_check\": {\n            \"concept_tag\": \"zero_indexing\",\n            \"question_text\": \"What will print(list(range(3))) output?\",\n            \"code_snippet\": \"print(list(range(3)))\",\n            \"options\": [\n              \"[1, 2, 3]\",\n              \"[0, 1, 2]\",\n              \"[0, 1, 2, 3]\"\n            ],\n            \"correct_answer\": \"[0, 1, 2]\",\n            \"misconception_map\": {\n              \"[1, 2, 3]\": \"Assumes range starts at 1 instead of 0\",\n              \"[0, 1, 2, 3]\": \"Assumes range stop argument is inclusive\"\n            },\n            \"explanation\": \"range(3) starts at 0 and produces 3 numbers: 0, 1, and 2.\"\n          },\n          \"remediation_blocks\": [\n            {\n              \"type\": \"callout\",\n              \"callout_type\": \"warning\",\n              \"text\": \"Remember: In Python, counting always starts at index 0, not 1!\"\n            },\n            {\n              \"type\": \"paragraph\",\n              \"text\": \"If you want numbers 1 through 3, specify the start: range(1, 4).\"\n            }\n          ]\n        }\n      ],\n      \"conclusion\": [\n        {\n          \"type\": \"paragraph\",\n          \"text\": \"Great job! You learned how for loops and range() work together in Python.\"\n        }\n      ],\n      \"segments\": [\n        {\n          \"order_in_lesson\": 1,\n          \"title\": \"Intro to Iteration\",\n          \"narration_text\": \"Welcome to loops in Python. Today we discover how computers automate repetition.\",\n          \"est_seconds\": 45,\n          \"attached_code\": \"for i in range(5):\\n    print(i)\"\n        }\n      ]\n    }\n  ]\n}"
            },
